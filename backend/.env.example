# Copy to backend/.env and adjust. Safe local defaults are built in.
HOST=127.0.0.1
PORT=8000
ANSWER_MODEL=qwen3.5:4b
# OLLAMA_URL MUST NAME A LOOPBACK HOST, and that is now enforced rather than
# assumed: the prompt sent to it contains retrieved document passages, so a
# non-loopback value would send client document text off this machine - the
# thing README:14 and ADR-0002 say never happens. A non-loopback value is
# refused at startup and again immediately before every request
# (app/config.check_model_url, app/model_transport).
OLLAMA_URL=http://127.0.0.1:11434
# A model on ANOTHER HOST needs BOTH of these, and every request to it writes
# an audit row. Two settings, on the market lane's precedent, so the lane that
# carries document text cannot be opened by one careless edit.
# ANSWER_MODEL_ALLOW_REMOTE_HOST=false
# ANSWER_MODEL_ALLOWED_HOSTS=

# Set these AFTER models are downloaded so no library can phone home.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ---------------------------------------------------------------- access
#
# AUTH_MODE
#   disabled       (default) every request sees every document. This is what
#                  the prototype demonstrated, and every existing test runs
#                  against it unchanged.
#   demo_required  a bearer token is required. Without one a request resolves
#                  to an EMPTY scope - it sees nothing, which is not the same
#                  as an error and not the same as everything.
AUTH_MODE=disabled

# HMAC signing key for bearer tokens. Ignored under `disabled`; REQUIRED and at
# least 32 characters under `demo_required`, checked at STARTUP rather than at
# first login - a system that boots and then rejects everyone looks broken, and
# one that boots with a guessable key looks like it is working. Generate with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
AUTH_SECRET=

# Token lifetime. Eight hours, and there is no refresh token: a Tier 2 answer
# takes ~50 seconds and an ingest runs for minutes, so a short token puts a
# login screen in the middle of a demo.
AUTH_TOKEN_SECONDS=28800

# Failed logins per email before a lockout, and the window in seconds. Held in
# memory, never in the database - a row per failed login would let anyone who
# can reach the port write to the SQLite file ingestion is using. The durable
# record is the audit_events table.
AUTH_MAX_ATTEMPTS=8
AUTH_LOCKOUT_SECONDS=300

# ------------------------------------------------------ external lanes
#
# EVERY EXTERNAL LANE IS OFF BY DEFAULT, and each needs TWO flags to open: one
# that enables the feature and one that permits public egress. Two settings so
# that no single careless edit can send anything off this machine. With any flag
# false the lane answers 409 `model_unavailable` rather than calling out.
#
# Market lane: the only one permitted to carry a human-typed search phrase, and
# only after it has been previewed and approved per query.
MARKET_LIVE_ENABLED=false
MARKET_ALLOW_PUBLIC_EGRESS=false

# Standards reader (the optional Claude lane). Disabled by default, per
# NORTH-STAR 2.1: a local model is the primary reasoner and external success
# never closes an offline acceptance gate.
STANDARDS_READER_ENABLED=false
STANDARDS_READER_ALLOW_PUBLIC_EGRESS=false

# Key for the standards reader. Leave EMPTY unless the reader lane is explicitly
# authorised. Never commit a value; backend/.env is gitignored for this reason.
ANTHROPIC_API_KEY=

# ------------------------------------------------------ watch folder
#
# A folder polled for new PDFs to ingest. Empty disables the watcher.
WATCH_FOLDER=
# Seconds between polls.
WATCH_INTERVAL_SECONDS=300
# Recorded as the uploader of watched files. Empty is allowed.
WATCH_OWNER_EMAIL=

# ------------------------------------------------------ CRS export
#
# Row 1 of the Comment Resolution Sheet when a review names no company: the
# operating company's name as its own template prints it. Kept here, not in
# code, because it is a client identifier. Empty prints nothing.
CRS_COMPANY_NAME=
