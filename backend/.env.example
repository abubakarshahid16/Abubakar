# Copy to backend/.env and adjust. Safe local defaults are built in.
HOST=127.0.0.1
PORT=8000
# A non-loopback HOST (0.0.0.0, a LAN address) with AUTH_MODE=disabled is
# REFUSED at startup: every caller on the network would see every document.
# Use AUTH_MODE=demo_required, or set this only if that really is intended.
# ALLOW_UNAUTHENTICATED_NETWORK_BIND=false
#
# Host names the API answers to, comma-separated. localhost, 127.0.0.1, ::1
# and a named HOST are always accepted; any other Host header is refused with
# 400 (DNS-rebinding protection). Leave empty on a laptop. Example:
# ALLOWED_HOSTS=rag-server.local
ALLOWED_HOSTS=
#
# /docs, /redoc and /openapi.json are served only under AUTH_MODE=disabled
# unless this is true.
# API_DOCS_ENABLED=false
ANSWER_MODEL=qwen3.5:4b
# OLLAMA_URL MUST NAME A LOOPBACK HOST, and that is now enforced rather than
# assumed: the prompt sent to it contains retrieved document passages, so a
# non-loopback value would send client document text off this machine - the
# thing README:14 and ADR-0002 say never happens. A non-loopback value is
# refused at startup and again immediately before every request
# (app/config.check_model_url, app/model_transport).
OLLAMA_URL=http://127.0.0.1:11434
# A model on ANOTHER HOST needs BOTH of these, and every request to it writes
# an audit row. Two settings, on the market lane's precedent, so the lane that
# carries document text cannot be opened by one careless edit.
# ANSWER_MODEL_ALLOW_REMOTE_HOST=false
# ANSWER_MODEL_ALLOWED_HOSTS=

# Set these AFTER models are downloaded so no library can phone home.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ---------------------------------------------------------------- access
#
# AUTH_MODE
#   disabled       (default) every request sees every document. This is what
#                  the prototype demonstrated, and every existing test runs
#                  against it unchanged.
#   demo_required  a bearer token is required. Without one a request resolves
#                  to an EMPTY scope - it sees nothing, which is not the same
#                  as an error and not the same as everything.
AUTH_MODE=disabled

# HMAC signing key for bearer tokens. Ignored under `disabled`; REQUIRED and at
# least 32 characters under `demo_required`, checked at STARTUP rather than at
# first login - a system that boots and then rejects everyone looks broken, and
# one that boots with a guessable key looks like it is working. Generate with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
AUTH_SECRET=

# Token lifetime. Eight hours, and there is no refresh token: a Tier 2 answer
# takes ~50 seconds and an ingest runs for minutes, so a short token puts a
# login screen in the middle of a demo.
AUTH_TOKEN_SECONDS=28800

# Failed logins per email before a lockout, and the window in seconds. Held in
# memory, never in the database - a row per failed login would let anyone who
# can reach the port write to the SQLite file ingestion is using. The durable
# record is the audit_events table.
AUTH_MAX_ATTEMPTS=8
AUTH_LOCKOUT_SECONDS=300

# ------------------------------------------------------ external lanes
#
# EVERY EXTERNAL LANE IS OFF BY DEFAULT, and each needs TWO flags to open: one
# that enables the feature and one that permits public egress. Two settings so
# that no single careless edit can send anything off this machine. With any flag
# false the lane answers 409 `model_unavailable` rather than calling out.
#
# Market lane: the only one permitted to carry a human-typed search phrase, and
# only after it has been previewed and approved per query.
MARKET_LIVE_ENABLED=false
MARKET_ALLOW_PUBLIC_EGRESS=false

# Standards reader (the optional Claude lane). Disabled by default, per
# NORTH-STAR 2.1: a local model is the primary reasoner and external success
# never closes an offline acceptance gate.
STANDARDS_READER_ENABLED=false
STANDARDS_READER_ALLOW_PUBLIC_EGRESS=false

# Key for the standards reader. Leave EMPTY unless the reader lane is explicitly
# authorised. Never commit a value; backend/.env is gitignored for this reason.
ANTHROPIC_API_KEY=

# ------------------------------------------------------ watch folder
#
# A folder polled for new PDFs to ingest. Empty disables the watcher.
WATCH_FOLDER=
# Seconds between polls.
WATCH_INTERVAL_SECONDS=300
# Recorded as the uploader of watched files. Empty is allowed.
WATCH_OWNER_EMAIL=

# ------------------------------------------------------ CRS export
#
# Row 1 of the Comment Resolution Sheet when a review names no company: the
# operating company's name as its own template prints it. Kept here, not in
# code, because it is a client identifier. Empty prints nothing.
CRS_COMPANY_NAME=

# Reasoning provider (owner decision 2026-09-25). claude is used ONLY when this is
# claude AND both STANDARDS_READER_* flags above are true AND ANTHROPIC_API_KEY is set;
# otherwise the local Ollama engine, with the reason logged.
REASONING_PROVIDER=ollama
CLAUDE_REASONING_MODEL=claude-sonnet-5
CLAUDE_LABELLING_MODEL=claude-haiku-4-5-20251001
CLAUDE_BUDGET_USD_PER_STEP=5
CLAUDE_BUDGET_USD_TOTAL=20

# Page-image (vision) reader for datasheet pages the text readers could not read.
# OFF by default. It runs ONLY when this is true AND REASONING_PROVIDER=claude AND
# both STANDARDS_READER_* flags are true AND ANTHROPIC_API_KEY is set. The Review
# screen shows which of these is missing beside "Read unread pages".
GEOMETRY_READER_ENABLED=false
# At most this many pages of one datasheet go to the vision reader.
VISION_MAX_PAGES_PER_DOCUMENT=10

# "AI reads, code checks" datasheet reader: off | ollama | claude. OFF by default,
# and NOT YET MEASURED on real datasheets. When on, every datasheet page with text
# is also read by the model (two runs must agree; every fact must quote the page)
# and merged with the rule readers: agreement raises confidence, disagreement keeps
# both values flagged for an engineer. claude runs ONLY when REASONING_PROVIDER=claude
# AND both STANDARDS_READER_* flags are true AND ANTHROPIC_API_KEY is set, and every
# call counts against CLAUDE_BUDGET_USD_*. ollama uses the local engine at OLLAMA_URL.
DATASHEET_AI_READER=off
# Local model for the ollama engine; empty = ANSWER_MODEL.
DATASHEET_AI_OLLAMA_MODEL=

# ------------------------------------------------------ B5 applicability
#
# The OWNER-APPROVED equipment taxonomy the scope decision matches standards'
# scope clauses against (JSON: {"lexicon": {phrase: [level, name]}, "types":
# {type: {"family": ..., "class": ...}}}). Empty = no taxonomy approved: the
# live review records "scope clauses not checked" and decides nothing from
# scope records. Never commit a client-specific taxonomy with client names.
APPLICABILITY_TAXONOMY_PATH=
# The scope decision by AI reasoning against each standard's stored, verified
# scope record (no taxonomy needed). ON by default (#736); false falls back to
# the taxonomy path above.
APPLICABILITY_REASONING_ENABLED=true

# ------------------------------------------------------ performance (2026-09-28)
#
# PRAGMA synchronous for every SQLite connection. NORMAL (default) fsyncs
# only at WAL checkpoints - safe against an application crash, cannot
# corrupt the file, but a power cut can lose the last few committed
# transactions. FULL restores the old fsync-every-commit behaviour.
SQLITE_SYNCHRONOUS=NORMAL
# Warm the embedder, reranker and acronym maps in a background thread at
# startup so the first question does not pay the model loads. Never blocks
# the server start and never writes the database.
STARTUP_WARMUP=true
# Passages per embedder forward pass. Larger uses more memory for similar
# throughput (bs 16 ~= 1.5 GB peak, bs 32 ~= 2.2 GB, bs 64 ~= 4.6 GB, measured).
EMBED_BATCH_SIZE=16
# ONNX intra-op threads for the e5 embedder. 0 = derive: half the logical
# cores (at least 1). Set explicitly to pin it per machine - 12 threads on
# an 8-thread box measured several times slower than a low thread count.
EMBED_THREADS=0
# ONNX Runtime CPU arena for the embedder session. Off by default: it saves
# real memory (the arena is held for the life of the process) at no
# measured cost to query latency. The reranker's arena (ONNX_CPU_ARENA_RERANK,
# unchanged, on by default) is worth ~575 ms per query and stays on.
ONNX_CPU_ARENA_EMBED=false
# How long Ollama keeps the answer model resident after an interactive call.
# Every caller sends the same options (num_ctx, num_thread, num_batch) and
# this keep_alive, so features no longer evict each other's loaded model.
# 5m since #666 (it was 30m, which held the memory after every call). A batch
# job keeps its own window and unloads at the end. The System Health models
# panel has a "Free model memory" button for an administrator.
OLLAMA_KEEP_ALIVE=5m

# The model the P1-AI exam asks (eval/p1ai). A setting, never hard-coded (#683).
P1_AI_MODEL=qwen3.5:2b
