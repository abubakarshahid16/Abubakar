# Copy to backend/.env and adjust. Safe local defaults are built in.
HOST=127.0.0.1
PORT=8000
ANSWER_MODEL=qwen3.5:4b
OLLAMA_URL=http://127.0.0.1:11434

# Set these AFTER models are downloaded so no library can phone home.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ---------------------------------------------------------------- access
#
# AUTH_MODE
#   disabled       (default) every request sees every document. This is what
#                  the prototype demonstrated, and every existing test runs
#                  against it unchanged.
#   demo_required  a bearer token is required. Without one a request resolves
#                  to an EMPTY scope - it sees nothing, which is not the same
#                  as an error and not the same as everything.
AUTH_MODE=disabled

# HMAC signing key for bearer tokens. Ignored under `disabled`; REQUIRED and at
# least 32 characters under `demo_required`, checked at STARTUP rather than at
# first login - a system that boots and then rejects everyone looks broken, and
# one that boots with a guessable key looks like it is working. Generate with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
AUTH_SECRET=

# Token lifetime. Eight hours, and there is no refresh token: a Tier 2 answer
# takes ~50 seconds and an ingest runs for minutes, so a short token puts a
# login screen in the middle of a demo.
AUTH_TOKEN_SECONDS=28800

# Failed logins per email before a lockout, and the window in seconds. Held in
# memory, never in the database - a row per failed login would let anyone who
# can reach the port write to the SQLite file ingestion is using. The durable
# record is the audit_events table.
AUTH_MAX_ATTEMPTS=8
AUTH_LOCKOUT_SECONDS=300
