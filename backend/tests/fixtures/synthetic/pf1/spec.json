    "number": "STD-INST-0108",
    "title": "Pressure transmitters (invented)",
    "sections": [
     {
      "clause": "1",
      "title": "Scope",
      "text": "This invented standard covers wired pressure transmitters."
     },
     {
      "clause": "4.1",
      "title": "Accuracy",
      "text": "The accuracy shall be 0.1 % of span or better."
     },
     {
      "clause": "4.2",
      "title": "Output",
      "text": "The output signal shall be 4-20 mA."
     },
     {
      "clause": "4.3",
      "title": "Ambient limit",
      "text": "The upper ambient temperature limit shall be at least 70 °C."
     },
     {
      "clause": "4.6",
      "title": "Ingress protection",
      "text": "The ingress protection rating shall be stated on the datasheet."
     },
     {
      "clause": "9.5",
      "title": "Wireless transmitters",
      "text": "A wireless transmitter shall state its battery life."
     }
    ]
   },
