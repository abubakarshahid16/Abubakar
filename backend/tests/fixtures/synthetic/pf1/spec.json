   "standard": {
    "number": "STD-PSV-0106",
    "title": "Pressure safety valves (invented)",
    "sections": [
     {
      "clause": "1",
      "title": "Scope",
      "text": "This invented standard covers spring loaded pressure safety valves."
     },
     {
      "clause": "4.1",
      "title": "Back pressure",
      "text": "For a conventional valve, the built-up back pressure shall not exceed 10 % of the set pressure."
     },
     {
      "clause": "4.2",
      "title": "Set pressure",
      "text": "The set pressure shall not exceed the vessel maximum allowable working pressure of 12 barg."
     },
     {
      "clause": "4.3",
      "title": "Capacity",
      "text": "The relieving capacity shall be at least 1.0 kg/s."
     },
     {
      "clause": "4.4",
      "title": "Lining",
      "text": "Where an internal lining is specified, its thickness shall be at least 3 mm."
     },
     {
      "clause": "5.1",
      "title": "Orifice",
      "text": "The orifice designation shall be stated on the datasheet."
     },
     {
      "clause": "9.1",
      "title": "Pilot operated valves",
      "text": "A pilot operated valve shall have a pilot filter."
     }
    ]
   },
