   "standard": {
    "number": "STD-VSL-0102",
    "title": "Pressure vessels (invented)",
    "sections": [
     {
      "clause": "1",
      "title": "Scope",
      "text": "This invented standard covers unfired pressure vessels."
     },
     {
      "clause": "4.1",
      "title": "Design pressure",
      "text": "The design pressure shall be at least 10 percent above the maximum operating pressure."
     },
     {
      "clause": "5.2",
      "title": "Corrosion allowance",
      "text": "The corrosion allowance shall be at least 3 mm."
     },
     {
      "clause": "5.4",
      "title": "Joint efficiency",
      "text": "The joint efficiency shall be at least 0.85."
     },
     {
      "clause": "6.1",
      "title": "Hydrostatic test",
      "text": "The hydrostatic test pressure shall be at least 1.3 times the design pressure."
     },
     {
      "clause": "8.2",
      "title": "Impact test",
      "text": "Impact test results shall be stated for shell material below minus 10 C design metal temperature."
     },
     {
      "clause": "9.1",
      "title": "Jacketed vessels",
      "text": "A jacketed vessel shall state the jacket design pressure."
     }
    ]
   },
