    "sections": [
     {
      "clause": "1",
      "title": "Scope",
      "text": "This invented standard covers low voltage electric motors."
     },
     {
      "clause": "4.1",
      "title": "Efficiency",
      "text": "The efficiency class shall be IE3 or higher."
     },
     {
      "clause": "4.2",
      "title": "Voltage",
      "text": "The rated voltage shall be 400 V."
     },
     {
      "clause": "4.3",
      "title": "Power",
      "text": "The rated power shall be at least 40 hp."
     },
     {
      "clause": "4.7",
      "title": "Starting method",
      "text": "The starting method shall be stated on the datasheet."
     },
     {
      "clause": "9.6",
      "title": "Hazardous areas",
      "text": "A motor for a hazardous area shall be Ex rated."
