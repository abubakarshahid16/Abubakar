   "standard": {
    "number": "STD-CV-0103",
    "title": "Control valves (invented)",
    "sections": [
     {
      "clause": "1",
      "title": "Scope",
      "text": "This invented standard covers control valves."
     },
     {
      "clause": "5.1",
      "title": "Capacity",
      "text": "The offered flow coefficient shall be at least the required flow coefficient."
     },
     {
      "clause": "6.2",
      "title": "Leakage",
      "text": "The seat leakage class shall be Class IV or tighter."
     },
     {
      "clause": "7.1",
      "title": "Noise",
      "text": "The noise level shall not exceed 85 dBA."
     },
     {
      "clause": "7.3",
      "title": "Stroke time",
      "text": "The valve stroke time shall not exceed 0.5 min."
     },
     {
      "clause": "9.3",
      "title": "Fire safety",
      "text": "A fire-safe certificate shall be stated for valves in hydrocarbon service."
     },
     {
      "clause": "9.6",
      "title": "Cryogenic service",
      "text": "A valve in cryogenic service shall have an extended bonnet."
     }
    ]
   },
