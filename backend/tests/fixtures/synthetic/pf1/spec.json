    "sections": [
     {
      "clause": "1",
      "title": "Scope",
      "text": "This invented standard covers centrifugal compressors."
     },
     {
      "clause": "4.3",
      "title": "Discharge temperature",
      "text": "The discharge temperature shall not exceed 150 °C."
     },
     {
      "clause": "4.4",
      "title": "Inlet pressure",
      "text": "The inlet pressure shall be at least 1.0 bar abs."
     },
     {
      "clause": "5.2",
      "title": "Seal gas",
      "text": "The seal gas shall be one of: nitrogen, dry air."
     },
     {
      "clause": "5.3",
      "title": "Lube oil",
      "text": "The lube oil shall be one of: synthetic, PAO."
     },
     {
