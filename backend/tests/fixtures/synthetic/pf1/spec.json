      "clause": "1",
      "title": "Scope",
      "text": "This invented standard covers atmospheric storage tanks."
     },
     {
      "clause": "4.1",
      "title": "Shell thickness",
      "text": "The shell thickness shall be at least 8 mm."
     },
     {
      "clause": "4.2",
      "title": "Design pressure",
      "text": "The design pressure shall be at least 0.1 barg."
     },
     {
      "clause": "4.3",
      "title": "Capacity",
      "text": "The nominal capacity shall be at least 500 m3."
     },
     {
      "clause": "4.5",
      "title": "Corrosion allowance",
      "text": "The corrosion allowance shall be stated on the datasheet."
     },
     {
      "clause": "9.3",
      "title": "Floating roofs",
      "text": "A floating roof tank shall have a rim seal."
     }
