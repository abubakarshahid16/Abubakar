   "standard": {
    "number": "STD-HX-0104",
    "title": "Shell and tube exchangers (invented)",
    "sections": [
     {
      "clause": "1",
      "title": "Scope",
      "text": "This invented standard covers shell and tube heat exchangers."
     },
     {
      "clause": "4.3",
      "title": "Design pressure",
      "text": "The shell side design pressure shall be at least 12.5 barg."
     },
     {
      "clause": "5.4",
      "title": "Tube velocity",
      "text": "The tube side velocity shall not exceed 3.0 m/s."
     },
     {
      "clause": "6.1",
      "title": "Fouling",
      "text": "The fouling resistance shall be at least 0.0003 m2K/W."
     },
     {
      "clause": "6.4",
      "title": "Approach",
      "text": "The minimum approach temperature shall be at least 5 K."
     },
     {
      "clause": "7.2",
      "title": "Tube thickness",
      "text": "The tube wall thickness shall be at least 0.07 in."
     },
     {
      "clause": "9.2",
      "title": "Floating head",
      "text": "A floating head exchanger shall state the pull-through clearance."
     }
    ]
