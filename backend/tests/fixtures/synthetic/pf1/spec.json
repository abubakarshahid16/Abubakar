   "standard": {
    "number": "STD-PUMP-0101",
    "title": "Centrifugal pumps (invented)",
    "sections": [
     {
      "clause": "1",
      "title": "Scope",
      "text": "This invented standard covers centrifugal pumps."
     },
     {
      "clause": "4.2",
      "title": "Design pressure",
      "text": "The design pressure shall be at least 12 barg."
     },
     {
      "clause": "5.1",
      "title": "Seals",
      "text": "The mechanical seal plan shall be stated on the datasheet."
     },
     {
      "clause": "6.3",
      "title": "Flow",
      "text": "The rated flow shall be at least the required flow.",
      "table": [
       [
        "Service",
        "Minimum flow"
       ],
       [
        "General",
        "100 m3/h"
       ]
      ]
     },
     {
      "clause": "7.1",
      "title": "Head",
      "text": "The differential head shall be at least 40 m of liquid column."
     },
     {
      "clause": "9.4",
      "title": "Steam turbines",
      "text": "A steam turbine driver shall have a trip valve."
     }
    ]
   },
