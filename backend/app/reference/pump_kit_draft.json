    {
      "id": "PMPD-04",
      "draft": true,
      "severity": "critical",
      "text": "At the rated flow, the NPSH available exceeds the NPSH required by at least 1 m. Not checked: the main firewater pump case (150% of rated flow) and the range from minimum flow to 120% of rated flow.",
      "source": {
        "standard": "SAES-G-005",
        "clause": "4.3.2",
        "page": 15
      },
      "rule": {
        "kind": "above_by",
        "left": "npsh_available",
        "right": "npsh_required",
        "percent": 0,
        "at_least": 1,
        "unit": "m"
      },
