    {
      "id": "PMPD-08",
      "draft": true,
      "severity": "major",
      "text": "AI draft, engineer to confirm. QUESTION ONLY, never decided: state the hydrostatic test pressure of the pressure casing. The clause applies to FIREWATER pumps only. Its rule: the test pressure is at least 1.5 times the sum of the pump's shutoff head and its maximum allowable suction head, and never less than 1,724 kPa gauge (250 psig), which is only the floor; the test lasts at least 10 minutes. Code does not compute it: the engineer confirms the limit.",
      "source": {
        "standard": "SAES-G-005",
        "clause": "6.7.4",
        "page": 29
      },
      "condition": {
        "role": "fluid",
        "any": [
          "fire"
        ],
        "may_be_any": [
          "water"
        ]
      },
      "rule": {
        "kind": "required",
        "field": "test_pressure"
      },
      "limit_draft": {
        "status": "AI draft, engineer to confirm",
        "quotes": [
          "All pressure-casing components of firewater pumps shall be hydrostatically tested as assemblies.",
          "The test pressure shall not be less than one and one half (1.5) times the sum of the pump",
          "but in no case shall it be less than 1,724 kPa gauge (250 psig). The hydrostatic test duration shall not be less than 10 minutes."
        ],
        "quotes_verified_against": "SAES-G-005 6.7.4, stored page 29: the quotes only",
        "applies_to": "firewater pumps only",
        "test_pressure_at_least": "1.5 x (shutoff head + maximum allowable suction head)",
        "floor": "1724 kPa gauge (250 psig)",
        "duration_at_least": "10 minutes",
        "applicability_note": "a stated fluid naming water but not fire (\"water\", \"sea water\") does not say whether this is a firewater pump, and a placeholder fluid states nothing: both stay a question for the engineer"
      },
      "tests": [
        {
          "name": "meets",
          "facts": [
            [
              "fluid",
              "fire water",
              null
            ],
            [
              "hydrotest pressure",
              "3000",
              "kPa"
            ]
          ],
          "expect": "NEEDS_ENGINEER_REVIEW"
        },
        {
          "name": "breaks",
          "facts": [
            [
              "fluid",
              "fire water",
              null
            ]
          ],
          "expect": "MISSING_INFORMATION"
        },
        {
          "name": "unclear",
          "facts": [
            [
              "fluid",
              "fire water",
              null
            ],
            [
              "hydrotest pressure",
              "*",
              null
            ]
          ],
          "expect": "MISSING_INFORMATION"
        },
        {
          "name": "not a firewater pump",
          "facts": [
            [
              "fluid",
              "crude oil",
              null
            ],
            [
              "hydrotest pressure",
              "1500",
              "kPa"
            ]
          ],
          "expect": "NOT_APPLICABLE"
        },
        {
          "name": "a placeholder fluid is a question",
          "facts": [
            [
              "fluid",
              "TBA",
              null
            ],
            [
              "hydrotest pressure",
              "100",
              "kPa"
            ]
          ],
          "expect": "NEEDS_ENGINEER_REVIEW"
        },
        {
          "name": "water does not say fire service",
          "facts": [
            [
              "fluid",
              "sea water",
              null
            ],
            [
              "hydrotest pressure",
              "100",
              "kPa"
            ]
          ],
          "expect": "NEEDS_ENGINEER_REVIEW"
        }
      ]
    },
