  "checklists": {
    "_about": "#746: the review checklist per equipment type, in the one datasheet-checks engine. Each item: id, plain text, source {standard, clause} (required), a rule (required, compare, constant, percent_of, allowed, or above_by: left >= right + the greater of a percent or an absolute margin), an optional condition {role, any} or a list of them that must all hold, a severity. Client standard items are written here in our own words (owner decision 2026-10-10); the local overlay <data_dir>/checklists/<type>.json stays for items not yet approved for the repo.",
    "Pressure Safety Valve": {
      "sign_off": {
        "status": "draft",
        "by": null,
        "date": null
      },
      "clauses_verified": false,
      "note": "DRAFT. API 520 Part I items: clause numbers are section headings found in the held copy; SAES-J-600 items: clause numbers and the check written in our own words from the held copy (owner decision 2026-10-10: client standard items go in this file, no verbatim text). The rule under each is an engineering reading, not checked line by line. Nothing here is binding until a client discipline engineer signs it off.",
      "items": [
        {
          "id": "PSV-01",
          "text": "The set pressure is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "3.49"
          },
          "rule": {
            "kind": "required",
            "field": "set_pressure"
          },
          "severity": "major"
        },
        {
          "id": "PSV-02",
          "text": "The maximum allowable working pressure is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "3.26"
          },
          "rule": {
            "kind": "required",
            "field": "mawp"
          },
          "severity": "major"
        },
        {
          "id": "PSV-03",
          "text": "The design pressure is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "3.16"
          },
          "rule": {
            "kind": "required",
            "field": "design_pressure"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-04",
          "text": "The maximum operating pressure is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "3.27"
          },
          "rule": {
            "kind": "required",
            "field": "operating_pressure"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-05",
          "text": "The relieving temperature is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "3.43"
          },
          "rule": {
            "kind": "required",
            "field": "relieving_temperature"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-06",
          "text": "The allowable overpressure is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.4.1"
          },
          "rule": {
            "kind": "required",
            "field": "overpressure"
          },
          "severity": "major"
        },
        {
          "id": "PSV-07",
          "text": "The built-up back pressure is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "3.7"
          },
          "rule": {
            "kind": "required",
            "field": "built_up_back_pressure"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-08",
          "text": "The superimposed back pressure is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "3.53"
          },
          "rule": {
            "kind": "required",
            "field": "superimposed_back_pressure"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-09",
          "text": "The cold differential test pressure is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "4.2.3"
          },
          "rule": {
            "kind": "required",
            "field": "cdtp"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-10",
          "text": "The required relieving capacity is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.6.1"
          },
          "rule": {
            "kind": "required",
            "field": "required_capacity"
          },
          "severity": "major"
        },
        {
          "id": "PSV-11",
          "text": "The rated relieving capacity is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "3.41"
          },
          "rule": {
            "kind": "required",
            "field": "rated_capacity"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-12",
          "text": "The effective orifice area is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.2"
          },
          "rule": {
            "kind": "required",
            "field": "orifice_area"
          },
          "severity": "major"
        },
        {
          "id": "PSV-13",
          "text": "The orifice designation is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.2"
          },
          "rule": {
            "kind": "required",
            "field": "orifice_designation"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-14",
          "text": "The inlet size is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "3.20"
          },
          "rule": {
            "kind": "required",
            "field": "inlet_size"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-15",
          "text": "The outlet size is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "3.34"
          },
          "rule": {
            "kind": "required",
            "field": "outlet_size"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-16",
          "text": "The valve type is stated as conventional, balanced (bellows) or pilot-operated.",
          "source": {
            "standard": "API 520-I",
            "clause": "4.2"
          },
          "rule": {
            "kind": "allowed",
            "field": "valve_type",
            "values": [
              "conventional",
              "balanced",
              "bellows",
              "pilot"
            ]
          },
          "severity": "minor"
        },
        {
          "id": "PSV-17",
          "text": "The fluid is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.5"
          },
          "rule": {
            "kind": "required",
            "field": "fluid"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-18",
          "text": "The fluid phase at relieving conditions is stated (gas or vapour, or liquid).",
          "source": {
            "standard": "API 520-I",
            "clause": "5.5"
          },
          "rule": {
            "kind": "allowed",
            "field": "fluid_phase",
            "values": [
              "gas",
              "vapour",
              "vapor",
              "steam",
              "liquid"
            ]
          },
          "severity": "minor"
        },
        {
          "id": "PSV-19",
          "text": "For gas or vapour relief, the molecular weight is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.6.3.1"
          },
          "rule": {
            "kind": "required",
            "field": "molecular_weight"
          },
          "severity": "minor",
          "condition": {
            "role": "fluid_phase",
            "any": [
              "gas",
              "vapour",
              "vapor",
              "steam"
            ]
          },
          "when_unknown": "evaluate"
        },
        {
          "id": "PSV-20",
          "text": "For gas or vapour relief, the compressibility factor is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.6.3.1"
          },
          "rule": {
            "kind": "required",
            "field": "compressibility"
          },
          "severity": "minor",
          "condition": {
            "role": "fluid_phase",
            "any": [
              "gas",
              "vapour",
              "vapor",
              "steam"
            ]
          },
          "when_unknown": "evaluate"
        },
        {
          "id": "PSV-21",
          "text": "For gas or vapour relief, the specific heat ratio (k) is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.6.2"
          },
          "rule": {
            "kind": "required",
            "field": "specific_heat_ratio"
          },
          "severity": "minor",
          "condition": {
            "role": "fluid_phase",
            "any": [
              "gas",
              "vapour",
              "vapor",
              "steam"
            ]
          },
          "when_unknown": "evaluate"
        },
        {
          "id": "PSV-22",
          "text": "For liquid relief, the density at relieving conditions is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.8"
          },
          "rule": {
            "kind": "required",
            "field": "density_relieving"
          },
          "severity": "minor",
          "condition": {
            "role": "fluid_phase",
            "any": [
              "liquid"
            ]
          },
          "when_unknown": "evaluate"
        },
        {
          "id": "PSV-23",
          "text": "For liquid relief, the viscosity at relieving conditions is stated.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.8.2.4"
          },
          "rule": {
            "kind": "required",
            "field": "viscosity_relieving"
          },
          "severity": "minor",
          "condition": {
            "role": "fluid_phase",
            "any": [
              "liquid"
            ]
          },
          "when_unknown": "evaluate"
        },
        {
          "id": "PSV-24",
          "text": "The set pressure does not exceed the maximum allowable working pressure.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.4.2.1"
          },
          "rule": {
            "kind": "compare",
            "left": "set_pressure",
            "op": "<=",
            "right": "mawp"
          },
          "severity": "critical"
        },
        {
          "id": "PSV-25",
          "text": "The maximum allowable working pressure is at least the design pressure.",
          "source": {
            "standard": "API 520-I",
            "clause": "3.26"
          },
          "rule": {
            "kind": "compare",
            "left": "mawp",
            "op": ">=",
            "right": "design_pressure"
          },
          "severity": "major"
        },
        {
          "id": "PSV-26",
          "text": "The maximum operating pressure leaves a margin below the set pressure (at most 90% of it).",
          "source": {
            "standard": "API 520-I",
            "clause": "3.32"
          },
          "rule": {
            "kind": "percent_of",
            "left": "operating_pressure",
            "op": "<=",
            "percent": 90,
            "right": "set_pressure"
          },
          "severity": "major"
        },
        {
          "id": "PSV-27",
          "text": "For a fire case, the overpressure does not exceed 21%.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.4.3.1"
          },
          "rule": {
            "kind": "constant",
            "field": "overpressure",
            "op": "<=",
            "value": 21,
            "unit": "%"
          },
          "severity": "major",
          "condition": {
            "role": "relief_case",
            "any": [
              "fire"
            ]
          }
        },
        {
          "id": "PSV-28",
          "text": "For a single device in a non-fire case, the overpressure does not exceed 10%.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.4.2.1"
          },
          "rule": {
            "kind": "constant",
            "field": "overpressure",
            "op": "<=",
            "value": 10,
            "unit": "%"
          },
          "severity": "major",
          "condition": {
            "role": "relief_case",
            "any": [
              "blocked",
              "control valve",
              "thermal",
              "tube rupture",
              "power failure",
              "reflux",
              "cooling"
            ]
          }
        },
        {
          "id": "PSV-29",
          "text": "For a conventional valve, the built-up back pressure does not exceed 10% of the set pressure.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.3.3.1"
          },
          "rule": {
            "kind": "percent_of",
            "left": "built_up_back_pressure",
            "op": "<=",
            "percent": 10,
            "right": "set_pressure"
          },
          "severity": "major",
          "condition": {
            "role": "valve_type",
            "any": [
              "conventional"
            ]
          }
        },
        {
          "id": "PSV-30",
          "text": "The cold differential test pressure does not exceed the set pressure.",
          "source": {
            "standard": "API 520-I",
            "clause": "4.2.3"
          },
          "rule": {
            "kind": "compare",
            "left": "cdtp",
            "op": "<=",
            "right": "set_pressure"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-31",
          "text": "The rated relieving capacity is at least the required relieving capacity.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.6.4.1"
          },
          "rule": {
            "kind": "compare",
            "left": "rated_capacity",
            "op": ">=",
            "right": "required_capacity"
          },
          "severity": "critical"
        },
        {
          "id": "PSV-32",
          "text": "For gas or vapour relief, the specific heat ratio (k) is above 1.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.6.2"
          },
          "rule": {
            "kind": "constant",
            "field": "specific_heat_ratio",
            "op": ">",
            "value": 1
          },
          "severity": "minor",
          "condition": {
            "role": "fluid_phase",
            "any": [
              "gas",
              "vapour",
              "vapor",
              "steam"
            ]
          },
          "when_unknown": "evaluate"
        },
        {
          "id": "PSV-33",
          "text": "For gas or vapour relief, the compressibility factor is above 0.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.6.3.1"
          },
          "rule": {
            "kind": "constant",
            "field": "compressibility",
            "op": ">",
            "value": 0
          },
          "severity": "minor",
          "condition": {
            "role": "fluid_phase",
            "any": [
              "gas",
              "vapour",
              "vapor",
              "steam"
            ]
          },
          "when_unknown": "evaluate"
        },
        {
          "id": "PSV-34",
          "text": "For gas or vapour relief, the molecular weight is above 0.",
          "source": {
            "standard": "API 520-I",
            "clause": "5.6.3.1"
          },
          "rule": {
            "kind": "constant",
            "field": "molecular_weight",
            "op": ">",
            "value": 0
          },
          "severity": "minor",
          "condition": {
            "role": "fluid_phase",
            "any": [
              "gas",
              "vapour",
              "vapor",
              "steam"
            ]
          },
          "when_unknown": "evaluate"
        },
        {
          "id": "PSV-S01",
          "text": "The inlet size is stated (the standard's minimum is 3/4 in threaded or 1 in flanged).",
          "source": {
            "standard": "SAES-J-600",
            "clause": "4.1.2"
          },
          "rule": {
            "kind": "required",
            "field": "inlet_size"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-S02",
          "text": "The inlet flange rating is at least ASME B16.5 Class 150.",
          "source": {
            "standard": "SAES-J-600",
            "clause": "4.1.3"
          },
          "rule": {
            "kind": "allowed",
            "field": "inlet_rating",
            "values": [
              "150",
              "300",
              "600",
              "900",
              "1500",
              "2500"
            ]
          },
          "severity": "major"
        },
        {
          "id": "PSV-S03",
          "text": "The set pressure is above the maximum operating pressure by at least the greater of 10% or 100 kPa.",
          "source": {
            "standard": "SAES-J-600",
            "clause": "8"
          },
          "rule": {
            "kind": "above_by",
            "left": "set_pressure",
            "right": "operating_pressure",
            "percent": 10,
            "at_least": 100,
            "unit": "kPa"
          },
          "severity": "major"
        },
        {
          "id": "PSV-S04",
          "text": "For a thermal relief valve, the set pressure does not exceed 110% of the maximum allowable pressure.",
          "source": {
            "standard": "SAES-J-600",
            "clause": "8.9.3"
          },
          "rule": {
            "kind": "percent_of",
            "left": "set_pressure",
            "op": "<=",
            "percent": 110,
            "right": "mawp"
          },
          "severity": "major",
          "condition": {
            "role": "relief_case",
            "any": [
              "thermal"
            ]
          }
        },
        {
          "id": "PSV-S05",
          "text": "The governing relief case is stated (external fire is included where the codes require it).",
          "source": {
            "standard": "SAES-J-600",
            "clause": "7.1"
          },
          "rule": {
            "kind": "required",
            "field": "relief_case"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-S06",
          "text": "The worst-case relieving rate the valve is sized for is stated.",
          "source": {
            "standard": "SAES-J-600",
            "clause": "10"
          },
          "rule": {
            "kind": "required",
            "field": "required_capacity"
          },
          "severity": "major"
        },
        {
          "id": "PSV-S07",
          "text": "The body material is stated (materials follow API 526 with the standard's exceptions).",
          "source": {
            "standard": "SAES-J-600",
            "clause": "6.1"
          },
          "rule": {
            "kind": "required",
            "field": "body_material"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-S08",
          "text": "The trim (nozzle and disc) material is stated.",
          "source": {
            "standard": "SAES-J-600",
            "clause": "6.1"
          },
          "rule": {
            "kind": "required",
            "field": "trim_material"
          },
          "severity": "minor"
        },
        {
          "id": "PSV-S09",
          "text": "In sour service, the spring material is stated (protected by bellows or a rupture disc, or crack-resistant).",
          "source": {
            "standard": "SAES-J-600",
            "clause": "6.2"
          },
          "rule": {
            "kind": "required",
            "field": "spring_material"
          },
          "severity": "major",
          "condition": {
            "role": "sour_service",
            "any": [
              "yes",
              "sour",
              "present",
              "required"
            ]
          }
        },
        {
          "id": "PSV-S10",
          "text": "For a bellows valve in sour service, the bellows are Alloy 625 or Alloy C-276.",
          "source": {
            "standard": "SAES-J-600",
            "clause": "6.3"
          },
          "rule": {
            "kind": "allowed",
            "field": "bellows_material",
            "values": [
              "625",
              "N06625",
              "C-276",
              "C276",
              "N10276"
            ]
          },
          "severity": "major",
          "condition": [
            {
              "role": "valve_type",
              "any": [
                "bellows"
              ]
            },
            {
              "role": "sour_service",
              "any": [
                "yes",
                "sour",
                "present",
                "required"
              ]
            }
          ]
        }
      ]
    }
  }
}
