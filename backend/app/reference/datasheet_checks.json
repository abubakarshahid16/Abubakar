  "_placeholders": "Moved 2026-09-27 to app/blank_markers.py - the ONE list of not-provided markers every datasheet reader and these checks read (CLAUDE.md rule 8).",
  "consistency": [
    {
      "id": "DS-C1",
      "left": "design_pressure",
      "op": ">=",
      "right": "operating_pressure",
      "text": "The design pressure should be at least the operating pressure."
    },
    {
      "id": "DS-C2",
      "left": "design_temperature",
      "op": ">=",
      "right": "operating_temperature",
      "text": "The design temperature should be at least the operating temperature."
    },
    {
      "id": "DS-C3",
      "left": "test_pressure",
      "op": ">",
      "right": "design_pressure",
      "text": "The test pressure should be higher than the design pressure."
    },
    {
      "id": "DS-C4",
      "left": "rated_flow",
      "op": ">=",
      "right": "min_flow",
      "text": "The rated flow should not be below the minimum flow."
    },
    {
      "id": "DS-C5",
      "left": "rated_flow",
      "op": "<=",
      "right": "max_flow",
      "text": "The rated flow should not be above the maximum flow."
    }
  ],
