#!/usr/bin/env bash
# Pre-commit guard for the RAG Intelligence System
#
# The GitHub repository slug is still `abubakarshahid16/saudi-aramco-rag-chatbot`
# and this line used to repeat it. Renaming the product did not rename the repo
# - that is a separate decision recorded in docs/rename-inventory.md section 6,
# and it remains open. This comment names the PRODUCT so it stops going stale
# every time the other question is deferred.
#
# COMPENSATING CONTROL. GitHub Advanced Security secret scanning is unavailable
# on this account tier, and branch protection cannot be enforced. See ADR-0004.
#
# This hook blocks a secret or a client document BEFORE it enters git history,
# which is strictly better than detecting it after the push.
#
# Install with:  bash scripts/install-git-hooks.sh
# Bypass (audit trail required):  git commit --no-verify

set -uo pipefail

RED=$'\033[0;31m'; GRN=$'\033[0;32m'; YLW=$'\033[0;33m'; NC=$'\033[0m'
fail=0

# ---------------------------------------------------------------------------
# 0. Never commit directly to main
# ---------------------------------------------------------------------------
# GitHub free tier cannot enforce branch protection (ADR-0004), so this hook is
# the only thing between a tired engineer and an unrevertable block landing
# straight on main. Two blocks have already landed that way, both after a
# post-merge "git switch main && git pull" followed by starting new work.
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ "$branch" = "main" ]; then
  echo "${RED}BLOCKED: direct commit to main${NC}"
  echo "  Branch discipline is what lets a bad block be rolled back cleanly."
  echo "  Move the staged work onto a branch - it comes with you:"
  echo "      git switch -c <type>/<issue>-<slug>"
  fail=1
fi

# ---------------------------------------------------------------------------
# 1. Forbidden file types
# ---------------------------------------------------------------------------
staged=$(git diff --cached --name-only --diff-filter=ACMR)

forbidden=$(printf '%s\n' "$staged" \
  | grep -E '\.(pdf|onnx|gguf|safetensors|bin|sqlite|sqlite3|db|db-wal|db-shm|lance)$' \
  | grep -v '^tests/fixtures/synthetic/' || true)

if [ -n "$forbidden" ]; then
  echo "${RED}BLOCKED: forbidden file type staged${NC}"
  printf '%s\n' "$forbidden" | sed 's/^/    /'
  echo ""
  echo "  Client PDFs, extracted text, embeddings, model weights and databases"
  echo "  must never enter this repository (EXECUTION.md section 6)."
  echo "  Synthetic fixtures belong in tests/fixtures/synthetic/."
  fail=1
fi

# ---------------------------------------------------------------------------
# 2. .env files
# ---------------------------------------------------------------------------
envfiles=$(printf '%s\n' "$staged" | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' || true)
if [ -n "$envfiles" ]; then
  echo "${RED}BLOCKED: .env file staged${NC}"
  printf '%s\n' "$envfiles" | sed 's/^/    /'
  fail=1
fi

# ---------------------------------------------------------------------------
# 2b. New client identifiers, in ADDED LINES ONLY
# ---------------------------------------------------------------------------
# Owner decision 2026-09-23. Client document numbers and the client's own
# abbreviation are ALREADY in 18 tracked files - that is B27, an accepted risk,
# and this hook does not reopen it. What it stops is the next one.
#
# ADDED LINES ONLY, deliberately. A rule that blocked any file containing these
# strings would block every commit to comparison.py, datasheets.py,
# match_rules.py, eight test files and four docs, and a hook that blocks
# ordinary work gets bypassed until it is worthless. Scanning `^+` lines means
# existing occurrences are invisible and only new ones are refused.
#
# This file is excluded from its own scan: it has to name the strings it looks
# for, and it cannot be committed if it trips on itself.
client_ids='216400C|EF1975|DAS-M-03|DAS-I-06|KJO'
client_hits=''
for f in $staged; do
  case "$f" in
    .githooks/pre-commit) continue ;;
  esac
  # `-E` ON BOTH GREPS. The second one was written `grep -v '^\+\+\+'` and
  # silently matched nothing useful: without -E, GNU grep reads `\+` as the
  # BRE repetition operator rather than a literal plus, so the filter dropped
  # every line and the check passed a file that did contain an identifier.
  # Caught by testing the block against a file that should have failed.
  hits=$(git diff --cached -U0 --diff-filter=ACMR -- "$f" \
    | grep -E '^\+' | grep -vE '^\+\+\+' \
    | grep -E "$client_ids" || true)
  if [ -n "$hits" ]; then
    client_hits="${client_hits}${f}:
$(printf '%s\n' "$hits" | sed 's/^/      /')
"
  fi
done

if [ -n "$client_hits" ]; then
  echo "${RED}BLOCKED: a new client identifier in an added line${NC}"
  printf '%s' "$client_hits"
  echo ""
  echo "  Client document numbers and the client's abbreviation must not enter"
  echo "  new lines in tracked files. Existing occurrences are B27, an accepted"
  echo "  risk, and are not blocked - this is only about not adding more."
  echo ""
  echo "  Write the ROLE the document plays instead:"
  echo "      the tuning document | the pump datasheet regression document"
  echo "      a multi-column material field | the client"
  echo "  and keep names, values and counts in the register, which is"
  echo "  direct-copy and never in git."
  fail=1
fi

# ---------------------------------------------------------------------------
# 3. gitleaks on staged content
# ---------------------------------------------------------------------------
# FAILS CLOSED. This block used to print a WARNING and let the commit through
# when gitleaks was missing, which meant the compensating control ADR-0004
# describes could be absent with nobody noticing - a fresh clone that skipped
# scripts/install-git-hooks.sh got a hook that checked file types and nothing
# else, and said so in yellow text that scrolls past. A secret scan that can
# be skipped by accident is not a control, so a missing scanner is now a
# blocked commit.
#
# The resolution order also no longer assumes Windows. It read
# "$LOCALAPPDATA/gitleaks/gitleaks.exe" unguarded under `set -u`, so on Linux,
# macOS, CI and any Windows shell that does not export LOCALAPPDATA the hook
# did not fail open - it aborted outright with "LOCALAPPDATA: unbound
# variable" before reaching the scan. Every candidate below is expansion-safe.
# Candidates in priority order, one per line: an explicit override first,
# then whatever is on PATH, then the two locations
# scripts/install-git-hooks.sh actually installs to, then the usual
# package-manager prefixes. Every expansion carries ":-" so an unset variable
# yields an empty candidate that the loop skips, instead of aborting the hook.
gitleaks_candidates() {
  printf '%s\n' "${GITLEAKS_PATH:-}"
  command -v gitleaks 2>/dev/null || true
  printf '%s\n' "${LOCALAPPDATA:-}/gitleaks/gitleaks.exe"
  printf '%s\n' "${HOME:-}/.local/bin/gitleaks"
  printf '%s\n' "/usr/local/bin/gitleaks"
  printf '%s\n' "/opt/homebrew/bin/gitleaks"
}

GITLEAKS=""
while IFS= read -r candidate; do
  # An unset LOCALAPPDATA leaves a bare "/gitleaks/gitleaks.exe" and an unset
  # GITLEAKS_PATH leaves "". Skip those rather than stat them.
  case "$candidate" in ""|"/gitleaks/gitleaks.exe") continue ;; esac
  if [ -x "$candidate" ]; then GITLEAKS="$candidate"; break; fi
done <<EOF
$(gitleaks_candidates)
EOF

if [ -z "$GITLEAKS" ]; then
  echo "${RED}BLOCKED: gitleaks not found - staged content cannot be scanned.${NC}"
  echo "  Secret scanning is this repository's compensating control for"
  echo "  GitHub Advanced Security being unavailable (ADR-0004). It is not"
  echo "  optional, so a missing scanner blocks rather than warns."
  echo ""
  echo "  Install it:"
  echo "      bash scripts/install-git-hooks.sh"
  echo "  Or point the hook at an existing binary:"
  echo "      export GITLEAKS_PATH=/path/to/gitleaks"
  echo ""
  echo "  If you must commit without a scan, that is the AUDITED BYPASS and"
  echo "  it has to be deliberate and recorded:"
  echo "      git commit --no-verify"
  fail=1
else
  if ! "$GITLEAKS" git --staged --redact --no-banner --config .gitleaks.toml; then
    echo "${RED}BLOCKED: gitleaks found a secret in staged content${NC}"
    echo "  Remove the secret. Do not use --no-verify to get past this."
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "${RED}Commit rejected.${NC}"
  exit 1
fi

echo "${GRN}pre-commit checks passed${NC}"
exit 0
