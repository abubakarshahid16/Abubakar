{
  "permissions": {
    "deny": [
      "Read(/backend/.env)",
      "Edit(/backend/.env)",
      "Read(**/backend/.env)",
      "Edit(**/backend/.env)",
      "Edit(/backend/data/rag_intelligence.sqlite*)",
      "Edit(**/backend/data/rag_intelligence.sqlite*)",
      "Bash(rm *rag_intelligence.sqlite*)",
      "Bash(mv *rag_intelligence.sqlite*)",
      "Bash(cp * *backend/data/rag_intelligence.sqlite*)",
      "Bash(sqlite3 *backend/data/rag_intelligence.sqlite)",
      "Bash(cp *backend/.env *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/trim_test_output.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/trim_test_output.py\""
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "backend/models"
    ]
  }
}
